# Copy to .env — never commit the real .env file.

# Zero-setup default (SQLite file). The README's target database is PostgreSQL:
DATABASE_URL=sqlite:///./assetnexus.db
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/assetnexus

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Uncertainty-gated trust thresholds (placeholders — owned by the AI/trust module)
TRUST_LOW=0.25
TRUST_MEDIUM=0.55

# Fill an empty database with the simulated demo dataset on startup
SEED_ON_STARTUP=true
